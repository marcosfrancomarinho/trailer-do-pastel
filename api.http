# Inicie a API com yarn dev e execute as requisições pelo REST Client.
# Altere testId para cadastrar novos registros sem repetir os nomes.
# Antes dos cadastros, aplique as migrations do projeto.
# Execute criarCategoria antes de criarProduto.
# Crie produto e adicional antes dos pedidos.

@baseUrl = http://localhost:3000
@testId = 003
@productName = Pastel de queijo {{testId}}
@productPrice = 12.50
@additionPrice = 2.50
@adminName = SEU_USUARIO
@adminPassword = SUA_SENHA
@historyDate = 2026-10-24
@accessToken = {{loginUsuario.response.body.$.accessToken}}

### Login de usuário — 200; retorna name, role e accessToken
# @name loginUsuario
POST {{baseUrl}}/login
Content-Type: application/json

{
  "name": "{{adminName}}",
  "password": "{{adminPassword}}"
}

### Cadastrar funcionário (somente ADMIN) — 201
# @name criarUsuario
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "marcosfranco{{testId}}",
  "password": "Pastel123!"
}

### Listar usuários com papel, sem expor senhas (somente ADMIN) — 200
GET {{baseUrl}}/users
Authorization: Bearer {{accessToken}}

### Excluir funcionário (somente ADMIN) — 204
DELETE {{baseUrl}}/users/{{criarUsuario.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Consultar se a loja aceita pedidos — 200
GET {{baseUrl}}/store/status

### Fechar a loja e impedir novos pedidos — 200
POST {{baseUrl}}/store/close
Authorization: Bearer {{accessToken}}

### Abrir a loja e aceitar pedidos novamente — 200
POST {{baseUrl}}/store/open
Authorization: Bearer {{accessToken}}

### Cadastrar categoria — 201
# @name criarCategoria
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Pastéis {{testId}}"
}

### Listar categorias — 200
# @name listarCategorias
GET {{baseUrl}}/categories

### Cadastrar mesa — 201
# @name criarMesa
POST {{baseUrl}}/tables
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "number": 1,
  "status": "FREE"
}

### Listar mesas com status e total acumulado — 200
GET {{baseUrl}}/tables
Authorization: Bearer {{accessToken}}

### Cadastrar produto sem adicionais — 201
# @name criarProduto
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "{{productName}}",
  "description": "Pastel recheado com queijo e orégano",
  "categoryId": "{{criarCategoria.response.body.$.id}}",
  "price": "{{productPrice}}",
  "available": true
}

### Listar todos os produtos — 200

GET {{baseUrl}}/products

### Atualizar preço e disponibilidade do produto — 200
PATCH {{baseUrl}}/products/{{criarProduto.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "price": "14.50",
  "available": true
}

### Substituir os adicionais do produto — 200
# Execute criarAdicional antes desta requisição.
PATCH {{baseUrl}}/products/{{criarProduto.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "additionIds": ["{{criarAdicional.response.body.$.id}}"]
}

### Listar produtos da categoria — 200
# @name listarProdutosDaCategoria
GET {{baseUrl}}/categories/{{criarCategoria.response.body.$.id}}/products

### Cadastrar adicional — 201
# @name criarAdicional
POST {{baseUrl}}/additions
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Queijo extra {{testId}}",
  "price": "{{additionPrice}}",
  "available": true
}

### Listar todos os adicionais — 200

GET {{baseUrl}}/additions

### Cadastrar produto com adicional — 201
# @name criarProdutoComAdicional
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Pastel com queijo extra {{testId}}",
  "description": "Pastel recheado com queijo e orégano",
  "categoryId": "{{criarCategoria.response.body.$.id}}",
  "price": "{{productPrice}}",
  "available": true,
  "additionIds": ["{{criarAdicional.response.body.$.id}}"]
}

### Listar adicionais do produto — 200

GET {{baseUrl}}/products/{{criarProduto.response.body.$.id}}/additions

### Cadastrar pedido com adicional — 201; total esperado: "34"
# Os IDs abaixo são obtidos das respostas de criarProduto e criarAdicional.
# A quantidade do adicional é aplicada a cada unidade do produto.
# @name criarPedido
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "Maria Silva",
  "customerPhone": "(11) 99999-9999",
  "observation": "Sem cebola, por favor",
  "items": [
    {
      "productId": "{{criarProduto.response.body.$.id}}",
      "quantity": 2,
      "additions": [
        {
          "additionId": "{{criarAdicional.response.body.$.id}}",
          "quantity": 1
        }
      ]
    }
  ]
}

### Cadastrar pedido sem adicionais — 201; total esperado: "14.5"
# O controller usa [] quando additions não é informado.
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "João Santos",
  "customerPhone": "11988887777",
  "tableId": null,
  "items": [
    {
      "productId": "{{criarProduto.response.body.$.id}}",
      "quantity": 1
    }
  ]
}

### Cadastrar pedido presencial vinculado à mesa — 201
# @name criarPedidoMesa
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "customerName": "Cliente da mesa 1",
  "customerPhone": "11999999999",
  "tableId": "{{criarMesa.response.body.$.id}}",
  "items": [
    {
      "productId": "{{criarProduto.response.body.$.id}}",
      "quantity": 1
    }
  ]
}

### Consultar pedidos da comanda aberta e o gasto atual da mesa — 200
GET {{baseUrl}}/tables/{{criarMesa.response.body.$.id}}/orders
Authorization: Bearer {{accessToken}}

### Cancelar e tirar um pedido da mesa, descontando seu valor — 200
# Permitido apenas enquanto estiver PENDING, CONFIRMED ou PREPARING.
DELETE {{baseUrl}}/tables/{{criarMesa.response.body.$.id}}/orders/{{criarPedidoMesa.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Liberar a mesa depois de concluir ou cancelar todos os pedidos vinculados — 200
PATCH {{baseUrl}}/tables/{{criarMesa.response.body.$.id}}/release
Authorization: Bearer {{accessToken}}

### Consultar comandas atuais e anteriores, incluindo pedidos cancelados — 200
GET {{baseUrl}}/tables/{{criarMesa.response.body.$.id}}/sessions
Authorization: Bearer {{accessToken}}

### Consultar comandas fechadas e pedidos online finalizados no dia — 200 (somente ADMIN)
# Ajuste historyDate para o dia do fechamento da comanda ou da finalização do pedido online.
GET {{baseUrl}}/tables/sessions/history?date={{historyDate}}
Authorization: Bearer {{accessToken}}

### Excluir mesa livre, preservando comandas anteriores — 204
DELETE {{baseUrl}}/tables/{{criarMesa.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Listar pedidos pendentes — 200
# @name listarPedidosPendentes
GET {{baseUrl}}/orders/pending
Authorization: Bearer {{accessToken}}

### Listar pedidos confirmados e em preparo — 200
GET {{baseUrl}}/orders/preparing
Authorization: Bearer {{accessToken}}

### Listar histórico administrativo — 200
GET {{baseUrl}}/orders/history
Authorization: Bearer {{accessToken}}

### Acompanhar pedido pelo token — 200
GET {{baseUrl}}/orders/tracking/{{criarPedido.response.body.$.trackingToken}}

### Atualizar status do pedido — 200
PATCH {{baseUrl}}/orders/{{criarPedido.response.body.$.id}}/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": "CONFIRMED"
}

### Concluir pedido quando estiver pronto — 200
PATCH {{baseUrl}}/orders/{{criarPedido.response.body.$.id}}/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": "COMPLETED"
}

### Senha inválida — 400, TOO_SHORT
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "usuario-invalido{{testId}}",
  "password": "abc123"
}

### Pedido sem itens — 400, EMPTY
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "Maria Silva",
  "customerPhone": "11999999999"
}

### Produto duplicado — 409, ALREADY_EXISTS
# Execute criarProduto antes desta requisição.
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "{{productName}}",
  "description": "Mesmo nome do produto já cadastrado",
  "categoryId": "{{criarCategoria.response.body.$.id}}",
  "price": "{{productPrice}}",
  "available": true
}
