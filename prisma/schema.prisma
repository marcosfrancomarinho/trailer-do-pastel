// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELED
}

enum TableStatus {
  FREE
  OCCUPIED
}

enum StoreStatus {
  OPEN
  CLOSED
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

model Store {
  id        Int         @id
  status    StoreStatus @default(OPEN)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("store")
}

model User {
  id        String   @id @default(uuid())
  name      String   @unique
  password  String
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now()) @map("created_at")

  histories OrderStatusHistory[]
  orders    Order[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Table {
  id        String      @id @default(uuid())
  number    Int
  status    TableStatus @default(FREE)
  totalSpent Decimal     @default(0) @map("total_spent")
  createdAt DateTime    @default(now()) @map("created_at")
  deletedAt DateTime?   @map("deleted_at")

  orders Order[]
  sessions TableSession[]

  @@map("tables")
}

model TableSession {
  id          String    @id @default(uuid())
  tableId     String    @map("table_id")
  openedAt    DateTime  @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  closedTotal Decimal?  @map("closed_total")

  table  Table   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([tableId, openedAt])
  @@map("table_sessions")
}

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  categoryId  String   @map("category_id")
  price       Decimal
  imageUrl    String?  @map("image_url")
  available   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  additions ProductAddition[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id            String      @id @default(uuid())
  tableId       String?     @map("table_id")
  userId        String?     @map("user_id")
  tableSessionId String?    @map("table_session_id")
  customerName  String      @map("customer_name")
  customerPhone String      @map("customer_phone")
  observation   String?
  status        OrderStatus @default(PENDING)
  total         Decimal
  trackingToken String      @unique @default(uuid()) @map("tracking_token")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items     OrderItem[]
  histories OrderStatusHistory[]
  table     Table? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([tableId])
  @@index([userId])
  @@index([tableSessionId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  quantity    Int
  unitPrice   Decimal @map("unit_price")

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  additions OrderItemAddition[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  userId    String?     @map("user_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model Addition {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Decimal
  available Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  orderItemAdditions OrderItemAddition[]
  products           ProductAddition[]

  @@map("additions")
}

model ProductAddition {
  productId  String @map("product_id")
  additionId String @map("addition_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addition Addition @relation(fields: [additionId], references: [id], onDelete: Cascade)

  @@id([productId, additionId])
  @@index([additionId])
  @@map("product_additions")
}

model OrderItemAddition {
  id          String  @id @default(uuid())
  orderItemId String  @map("order_item_id")
  additionId  String  @map("addition_id")
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addition  Addition  @relation(fields: [additionId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, additionId])
  @@map("order_item_additions")
}
